---
import BasicLayout from "./BasicLayout.astro";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
  title: string;
  description: string;
  page?: "travel";
  fullScreen?: string;
}

const { title, description, page, fullScreen } = Astro.props;
---

<BasicLayout title={title} description={description}>
  <div
    slot="loader"
    class="loader bg-gray-100 dark:bg-darkslate-700 text-gray-900 dark:text-neutral-50 text-3xl font-black uppercase flex justify-center items-center w-screen h-screen z-50 fixed top-0 bottom-0 right-0 left-0"
  >
  </div>
  <ThemeToggle />
  <slot />
</BasicLayout>
