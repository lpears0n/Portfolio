---
import Card from "./Card/index.astro";
import Pulse from "./Pulse.astro";
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-2">
  <div class="flex justify-between w-full items-start mb-2">
    <div class="flex flex-col">
      <h2 class="text-gray-900 dark:text-white">Now</h2>
      <a href="https://sive.rs/nowff" target="_blank">
        <span class="text-xs text-gray-500 dark:text-gray-500 cursor-pointer">what's that ?</span>
      </a>
    </div>
    <Pulse />
  </div>
  <p class="text-xs text-gray-800 dark:text-white">Expanding my local LLM capabilities and gaining hands-on cloud provider experience across AWS, Azure, and OVHcloud.</p>
</Card>
