---
interface Props {
  title?: string;
  body?: string;
  inheritColor?: boolean;
}

const { title, body, inheritColor = false } = Astro.props;
---

<>
  {title && <h2 class={`text-xl font-bold m-0 z-20 ${inheritColor ? '' : 'text-gray-900 dark:text-white'}`}>{title}</h2>}
  {body && <p class={`m-0 font-light text-base ${inheritColor ? '' : 'text-gray-700 dark:text-gray-300'}`}>{body}</p>}
  <slot />
</>
