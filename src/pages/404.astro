---
import BasicLayout from "../layouts/BasicLayout.astro";
---

<BasicLayout
  title="404 - Page Not Found | Lucas Pearson"
  description="The page you're looking for doesn't exist."
>
  <main class="flex flex-col items-center justify-center min-h-screen p-4 text-center">
    <h1 class="text-6xl font-bold mb-4 text-gray-900 dark:text-white">404</h1>
    <p class="text-xl mb-8 text-gray-700 dark:text-gray-300">
      Oops! The page you're looking for doesn't exist.
    </p>
    <a
      href="/"
      class="text-white bg-primary-500 hover:bg-primary-600 px-6 py-3 rounded-lg transition-colors duration-200"
    >
      Go Home
    </a>
  </main>
</BasicLayout>
