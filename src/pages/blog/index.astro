---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PostRow from "../../components/Blog/PostRow.astro";

const posts = (await getCollection("blog"))?.sort(
  (blogEntryA: CollectionEntry<"blog">, blogEntryB: CollectionEntry<"blog">) =>
    (blogEntryB.data.pubDate || new Date()).getTime() -
    (blogEntryA.data.pubDate || new Date()).getTime()
) as CollectionEntry<"blog">[] | undefined;
---

<script>
  import { timeline, type TimelineDefinition } from "motion";
  import { loaderAnimation } from "../../lib/constants";

  const sequence = [loaderAnimation];

  timeline(sequence as TimelineDefinition);
</script>

<Layout
  title="Lucas Pearson - Blog"
  description="Full-Time Student & Software Developer with a focus on learning, sharing, and improving my career-readiness."
>
  <main
    class="w-screen h-screen flex flex-col justify-start items-start max-w-3xl mx-auto p-8"
  >
    <a
      href="/"
      class="text-white dark:text-white bg-neutral-900 dark:bg-neutral-900 hover:bg-neutral-800 dark:hover:bg-neutral-800 px-4 py-2 mb-8 border-1 border-solid border-neutral-600 rounded-lg"
      >Back</a
    >
    <h1 class="text-4xl font-bold mb-4 text-gray-900 dark:text-neutral-100">Posts</h1>
    <ul class="w-full">
      {
        posts?.map((post) => (
          <PostRow
            title={post.data.title || "No title"}
            date={post.data.pubDate || new Date()}
            url={post.slug}
          />
        ))
      }
    </ul>
  </main>
</Layout>
